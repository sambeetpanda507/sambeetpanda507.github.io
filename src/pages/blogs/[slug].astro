---
import Head from '../../components/Head.astro';
import { blogs, getBlogBySlug } from '../../data/blogs';
export function getStaticPaths() { return blogs.map((post) => ({ params: { slug: post.slug } })); }
const { slug } = Astro.params;
const post = getBlogBySlug(slug!);
if (!post) return Astro.redirect('/blogs/');
const url = `https://sambeetpanda507.github.io/blogs/${post.slug}/`;
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <Head title={`${post.title} — Sambeet Sekhar Panda`} description={post.summary} url={url} ogType="article" />
</head>
<body>
<header class="site-header">
  <nav class="wrap nav-row">
    <a class="brand" href="/">Sambeet<span>.</span></a>
    <div class="navlinks" id="navlinks"><a href="/">Home</a><a class="active" href="/blogs/">Blogs</a><a href="/#projects">Projects</a></div>
    <div class="actions">
      <button class="icon" id="theme" type="button" aria-label="Toggle theme">◐</button>
      <button class="icon nav-toggle" type="button" data-menu-toggle aria-label="Toggle menu" aria-expanded="false" aria-controls="navlinks">☰</button>
    </div>
  </nav>
  <div class="progress" aria-hidden="true"></div>
</header>
<main>
  <article class="wrap article">
    <a class="back fade-in" href="/blogs/"><span class="arr">←</span> All blogs</a>
    <div class="meta fade-in" style="--d:80ms">LINKEDIN → BLOG · TECHNICAL NOTES</div>
    <h1 class="fade-in" style="--d:160ms">{post.title}</h1>
    <p class="dek fade-in" style="--d:260ms">{post.summary}</p>
    <div class="tags fade-in" style="--d:340ms">{post.tags.map(tag => <span>{tag}</span>)}</div>
    <div class="content">
      {post.sections.map(section => <section class="rv">{section.heading && <h2>{section.heading}</h2>}{section.paragraphs?.map(p => <p>{p}</p>)}{section.bullets && <ul>{section.bullets.map(item => <li>{item}</li>)}</ul>}</section>)}
    </div>
    <aside class="source rv"><div><span>SOURCE</span><strong>{post.sourceLabel}</strong></div><a href={post.sourceUrl} target="_blank" rel="noreferrer">View original post on LinkedIn ↗</a></aside>
  </article>
</main>
<footer class="site-footer"><div class="wrap"><span>© {new Date().getFullYear()} Sambeet Sekhar Panda</span><a href="/blogs/">More writing →</a></div></footer>

<style is:global>
.wrap.article { width: min(900px, 100%); padding-block: 70px 110px; }
.back { display: inline-flex; gap: 8px; color: var(--muted); font: 500 .8rem/1 var(--mono); transition: color .2s; }
.back .arr { display: inline-block; transition: transform .35s var(--ease); }
.back:hover { color: var(--signal); }
.back:hover .arr { transform: translateX(-4px); }
.meta { margin-top: 56px; color: var(--ok); font: 500 .72rem/1.4 var(--mono); letter-spacing: .12em; }
.article h1 { margin: 18px 0 26px; font-size: clamp(2.6rem, 6.4vw, 5rem); font-weight: 850; font-stretch: 112%; line-height: .98; letter-spacing: -.045em; }
.dek { max-width: 62ch; margin: 0; color: var(--muted); font-size: 1.18rem; }
.tags { display: flex; flex-wrap: wrap; gap: 7px; padding: 26px 0 48px; border-bottom: 1px solid var(--line); }
.tags span { padding: 6px 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); color: var(--muted); font: 500 .7rem/1 var(--mono); }
.content { max-width: 70ch; margin: 60px auto; }
.content section { margin: 0 0 46px; }
.content h2 { margin: 0 0 16px; font-size: clamp(1.5rem, 2.6vw, 1.9rem); font-weight: 750; letter-spacing: -.025em; }
.content p { margin: 0 0 20px; font-size: 1.06rem; line-height: 1.8; color: color-mix(in srgb, var(--fg) 86%, var(--muted)); }
.content ul { margin: 0; padding-left: 20px; }
.content li { margin: 10px 0; color: color-mix(in srgb, var(--fg) 84%, var(--muted)); }
.content li::marker { color: var(--signal); }
.source { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 26px; border: 1px solid var(--line); border-radius: 16px; background: var(--panel); transition: border-color .3s; }
.source:hover { border-color: color-mix(in srgb, var(--signal) 45%, var(--line)); }
.source div { display: flex; flex-direction: column; gap: 4px; }
.source span { color: var(--muted); font: 500 .66rem/1 var(--mono); letter-spacing: .12em; }
.source strong { font-size: .9rem; }
.source a { color: var(--signal); font: 600 .8rem/1.3 var(--mono); }
.site-footer { border-top: 1px solid var(--line); }
.site-footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-block: 28px 44px; color: var(--faint); font: 500 .74rem/1.4 var(--mono); }
.site-footer a:hover { color: var(--signal); }
@media (max-width: 650px) {
  .article { padding-top: 48px; }
  .meta { margin-top: 40px; }
  .source { flex-direction: column; align-items: flex-start; }
}
</style>
</body>
</html>
