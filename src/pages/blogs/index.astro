---
import Head from '../../components/Head.astro';
import { blogs } from '../../data/blogs';
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <Head
    title="Blogs — Sambeet Sekhar Panda"
    description="Technical writing by Sambeet Sekhar Panda on backend engineering, Go, PostgreSQL, search, concurrency, streaming, and system design."
    url="https://sambeetpanda507.github.io/blogs/"
  />
</head>
<body>
<header class="site-header">
  <nav class="wrap nav-row">
    <a class="brand" href="/">Sambeet<span>.</span></a>
    <div class="navlinks" id="navlinks"><a href="/">Home</a><a href="/#projects">Projects</a><a class="active" href="/blogs/">Blogs</a><a href="/#contact">Contact</a></div>
    <div class="actions">
      <button class="icon" id="theme" type="button" aria-label="Toggle theme">◐</button>
      <button class="icon nav-toggle" type="button" data-menu-toggle aria-label="Toggle menu" aria-expanded="false" aria-controls="navlinks">☰</button>
    </div>
  </nav>
  <div class="progress" aria-hidden="true"></div>
</header>
<main class="wrap">
  <section class="hero" id="hero">
    <canvas class="field" id="field" aria-hidden="true"></canvas>
    <p class="eyebrow fade-in">TECHNICAL WRITING · FROM LINKEDIN</p>
    <h1 class="fade-in" style="--d:120ms">Notes on <span>building systems.</span></h1>
    <p class="lead fade-in" style="--d:260ms">Backend engineering, Go, PostgreSQL, search, concurrency, streaming, and the things I learn while building. These articles are adapted from technical posts I originally published on LinkedIn.</p>
  </section>
  <section class="posts" id="posts">
    {blogs.map((post, i) => <article class="card"><a class="card-main" href={`/blogs/${post.slug}/`}><div class="top"><span class="num">{String(i+1).padStart(2,'0')}</span><span class="source">LINKEDIN → BLOG</span></div><h2>{post.title}</h2><p>{post.summary}</p><div class="tags">{post.tags.map(tag => <span>{tag}</span>)}</div><strong>Read article <span class="arr">→</span></strong></a><a class="original" href={post.sourceUrl} target="_blank" rel="noreferrer">Original LinkedIn post ↗</a></article>)}
  </section>
</main>
<footer class="site-footer"><div class="wrap"><span>© {new Date().getFullYear()} Sambeet Sekhar Panda</span><a href="/">Back to portfolio ↑</a></div></footer>

<script>
  import { motionOK, finePointer } from '../../scripts/site';
  import { embeddingField } from '../../scripts/space';

  embeddingField(document.getElementById('field') as HTMLCanvasElement, document.getElementById('hero')!, { centerX: .78 });
  if (finePointer && motionOK) {
    document.querySelectorAll<HTMLElement>('#posts .card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        card.style.setProperty('--mx', `${x * 100}%`);
        card.style.setProperty('--my', `${y * 100}%`);
        card.style.setProperty('--rx', `${(.5 - y) * 6}deg`);
        card.style.setProperty('--ry', `${(x - .5) * 8}deg`);
      });
      card.addEventListener('pointerleave', () => { card.style.setProperty('--rx', '0deg'); card.style.setProperty('--ry', '0deg'); });
    });
  }
</script>

<style is:global>
.hero { position: relative; isolation: isolate; padding-block: clamp(80px, 11vw, 140px) clamp(48px, 6vw, 80px); border-bottom: 1px solid var(--line); }
.field { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; -webkit-mask-image: radial-gradient(ellipse 60% 90% at 78% 50%, #000 20%, transparent 75%); mask-image: radial-gradient(ellipse 60% 90% at 78% 50%, #000 20%, transparent 75%); }
.eyebrow, .source, .num { font: 500 .72rem/1.4 var(--mono); letter-spacing: .12em; color: var(--muted); }
.eyebrow { margin: 0; }
.hero h1 { margin: 18px 0 28px; max-width: 12ch; font-size: clamp(3.2rem, 8vw, 7rem); font-weight: 850; font-stretch: 116%; line-height: .9; letter-spacing: -.05em; }
.hero h1 span { color: var(--signal); }
.lead { margin: 0; max-width: 60ch; color: var(--muted); font-size: 1.1rem; }
.posts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; padding-block: 60px 110px; perspective: 1400px; }
.card { --mx: 50%; --my: 50%; --rx: 0deg; --ry: 0deg; position: relative; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); transform: rotateX(var(--rx)) rotateY(var(--ry)); transform-style: preserve-3d; transition: transform .5s var(--ease), border-color .3s; }
.card::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(420px circle at var(--mx) var(--my), color-mix(in srgb, var(--signal) 18%, transparent), transparent 45%); opacity: 0; transition: opacity .35s; pointer-events: none; }
.card:hover { border-color: color-mix(in srgb, var(--signal) 50%, var(--line)); }
.card:hover::before { opacity: 1; }
.card-main { position: relative; display: flex; flex-direction: column; flex: 1; padding: 30px; transform-style: preserve-3d; }
.card-main > * { transition: transform .5s var(--ease); }
.card:hover h2 { transform: translateZ(30px); }
.card:hover .tags { transform: translateZ(18px); }
.card:hover strong { transform: translateZ(22px); }
.top { display: flex; justify-content: space-between; gap: 12px; }
.num { color: var(--signal); }
.card h2 { margin: 30px 0 14px; font-size: 1.5rem; font-weight: 750; font-stretch: 104%; line-height: 1.15; letter-spacing: -.02em; }
.card p { margin: 0 0 24px; color: var(--muted); }
.tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: auto; margin-bottom: 24px; }
.tags span { padding: 6px 9px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel-2); color: var(--muted); font: 500 .7rem/1 var(--mono); }
.card strong { color: var(--signal); font: 500 .8rem/1 var(--mono); }
.card strong .arr { display: inline-block; transition: transform .35s var(--ease); }
.card:hover strong .arr { transform: translateX(5px); }
.original { position: relative; display: block; padding: 14px 30px; border-top: 1px solid var(--line); border-radius: 0 0 18px 18px; background: var(--panel-2); color: var(--muted); font: 500 .74rem/1 var(--mono); transition: color .2s; }
.original:hover { color: var(--fg); }
.site-footer { border-top: 1px solid var(--line); }
.site-footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-block: 28px 44px; color: var(--faint); font: 500 .74rem/1.4 var(--mono); }
.site-footer a:hover { color: var(--signal); }
@media (prefers-reduced-motion: no-preference) {
  @supports (animation-timeline: view()) {
    .posts .card { animation: pop linear both; animation-timeline: view(); animation-range: entry 0% entry 60%; }
    @keyframes pop { from { opacity: 0; translate: 0 60px; } }
  }
}
@media (max-width: 760px) {
  .posts { grid-template-columns: 1fr; }
}
</style>
</body>
</html>
