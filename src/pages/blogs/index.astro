---
import { blogs } from '../../data/blogs';
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Technical writing by Sambeet Sekhar Panda on backend engineering, Go, PostgreSQL, search, concurrency, streaming, and system design." />
  <title>Blogs — Sambeet Sekhar Panda</title>
  <link rel="canonical" href="https://sambeetpanda507.github.io/blogs/" />
  <script is:inline>const t=localStorage.getItem('theme');document.documentElement.dataset.theme=t||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');</script>
</head>
<body>
<header><nav class="wrap"><a class="brand" href="/">Sambeet<span>.</span></a><div class="navlinks"><a href="/">Home</a><a href="/#projects">Projects</a><a class="active" href="/blogs/">Blogs</a><a href="/#contact">Contact</a></div><button class="icon" id="theme" aria-label="Toggle theme">◐</button></nav></header>
<main class="wrap">
  <section class="hero"><p class="eyebrow">TECHNICAL WRITING · FROM LINKEDIN</p><h1>Notes on <span>building systems.</span></h1><p class="lead">Backend engineering, Go, PostgreSQL, search, concurrency, streaming, and the things I learn while building. These articles are adapted from technical posts I originally published on LinkedIn.</p></section>
  <section class="posts">
    {blogs.map((post, i) => <article class="card"><a class="card-main" href={`/blogs/${post.slug}/`}><div class="top"><span class="num">0{i+1}</span><span class="source">LINKEDIN → BLOG</span></div><h2>{post.title}</h2><p>{post.summary}</p><div class="tags">{post.tags.map(tag => <span>{tag}</span>)}</div><strong>Read article →</strong></a><a class="original" href={post.sourceUrl} target="_blank" rel="noreferrer">Original LinkedIn post ↗</a></article>)}
  </section>
</main>
<footer class="wrap"><span>© {new Date().getFullYear()} Sambeet Sekhar Panda</span><a href="/">Back to portfolio ↑</a></footer>
<script is:inline>document.getElementById('theme')?.addEventListener('click',()=>{const n=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=n;localStorage.setItem('theme',n)});</script>
<style>
:root{--bg:#090a0c;--card:#111216;--text:#f4f4f1;--muted:#9a9ba3;--line:#25262b;--accent:#d8ff66}html[data-theme=light]{--bg:#f7f7f3;--card:#fff;--text:#141416;--muted:#66676d;--line:#dddeda;--accent:#5e7800}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;line-height:1.65}body:before{content:'';position:fixed;inset:0;z-index:-1;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:64px 64px;mask-image:linear-gradient(#000,transparent 55%);opacity:.3}a{color:inherit;text-decoration:none}.wrap{width:min(1060px,calc(100% - 42px));margin:auto}header{position:sticky;top:0;z-index:10;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:blur(18px)}nav{height:72px;display:flex;align-items:center;gap:30px}.brand{font-weight:900}.brand span,h1 span{color:var(--accent)}.navlinks{margin-left:auto;display:flex;gap:25px}.navlinks a{font-size:.84rem;color:var(--muted)}.navlinks .active{color:var(--text)}.icon{border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:9px;height:37px;width:37px;cursor:pointer}.hero{padding:120px 0 70px;border-bottom:1px solid var(--line)}.eyebrow,.source,.num{font-family:ui-monospace,SFMono-Regular,monospace;letter-spacing:.12em;color:var(--muted);font-size:.72rem}.hero h1{font-size:clamp(3.4rem,8vw,7rem);line-height:.92;letter-spacing:-.065em;margin:18px 0 28px;max-width:850px}.lead{color:var(--muted);font-size:1.1rem;max-width:720px}.posts{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;padding:60px 0 100px}.card{border:1px solid var(--line);background:var(--card);border-radius:15px;overflow:hidden;display:flex;flex-direction:column}.card-main{padding:30px;display:flex;flex-direction:column;flex:1}.top{display:flex;justify-content:space-between}.num{color:var(--accent)}.card h2{font-size:1.45rem;line-height:1.2;letter-spacing:-.03em;margin:32px 0 14px}.card p{color:var(--muted);margin:0 0 25px}.tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:auto;margin-bottom:26px}.tags span{font-family:ui-monospace,monospace;font-size:.68rem;border:1px solid var(--line);border-radius:999px;padding:5px 8px;color:var(--muted)}.card strong{font-size:.8rem;color:var(--accent)}.original{border-top:1px solid var(--line);padding:13px 30px;font-size:.72rem;color:var(--muted)}.card:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--accent) 45%,var(--line));transition:.2s}.original:hover{color:var(--accent)}footer{border-top:1px solid var(--line);padding:28px 0 45px;display:flex;justify-content:space-between;color:var(--muted);font-size:.76rem}@media(max-width:720px){.navlinks a:nth-child(2),.navlinks a:nth-child(4){display:none}.hero{padding-top:80px}.posts{grid-template-columns:1fr}.wrap{width:min(100% - 28px,1060px)}footer{gap:15px;flex-direction:column}}
</style>
</body></html>
