const projects = [
  {
    title: 'Hybrid Search System',
    tag: 'Go · PostgreSQL · Search',
    desc: 'A microservices-based search system combining semantic vector search with lexical BM25 ranking, built to explore relevance, intent, and scalable retrieval.',
    stack: 'Go · PostgreSQL · pgvector · BM25 · HNSW · Ollama',
    source: 'LinkedIn project',
  },
  {
    title: 'Work Log Search & Analytics',
    tag: 'Go · PostgreSQL · Analytics',
    desc: 'A work-log management system with fuzzy search, ranked full-text search, and an analytics dashboard for task, status, work-type, and priority trends.',
    stack: 'Go net/http · PostgreSQL · pg_trgm · Full-text Search · Vue.js 3',
    source: 'LinkedIn project',
  },
  {
    title: 'AI Course Generation Pipeline',
    tag: 'AI · Distributed Processing',
    desc: 'Asynchronous document-to-course generation with resilient workers, semantic chunking, human checkpoints, and LLM orchestration.',
