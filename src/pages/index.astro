---
import { projects } from '../data/projects';
const linkedin = 'https://www.linkedin.com/in/sambeetsekharpanda/';

const skillGroups = [
  { title: 'Backend Languages & APIs', note: 'Primary focus', skills: ['Go','Python','Node.js','TypeScript','FastAPI','Express','REST APIs','Authentication'] },
  { title: 'Databases & Search', note: 'Deepening expertise', skills: ['PostgreSQL','MongoDB','Redis','pgvector','BM25','Full-text Search','Indexing','Query Optimization'] },
  { title: 'Systems & Infrastructure', note: 'Production delivery', skills: ['Docker','Azure','GitHub Actions','CI/CD','Linux','RabbitMQ','Distributed Workflows','Observability'] },
  { title: 'Applied AI Engineering', note: 'Supporting capability', skills: ['LangGraph','LangChain','RAG','Embeddings','Vector Databases','LLM APIs','Agent Workflows'] },
  { title: 'Frontend & Product', note: 'Full-stack delivery', skills: ['React','Next.js','Astro','Vue.js','HTML','CSS','Responsive UI'] },
];

const principles = [
  ['Build for clarity', 'Readable systems beat clever systems.'],
  ['Measure before optimizing', 'Performance work should be driven by evidence.'],
  ['Design for failure', 'Production systems should assume dependencies can fail.'],
  ['Automate repetition', 'Tooling should reduce developer friction.'],
];
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Portfolio of Sambeet Sekhar Panda, a backend-focused software engineer working across APIs, databases, search systems, developer tooling, cloud delivery, and applied AI." />
  <meta property="og:title" content="Sambeet Sekhar Panda — Backend-Focused Software Engineer" />
  <meta property="og:description" content="Backend engineering, Go, Python, PostgreSQL, search systems, APIs, developer tooling, and applied AI." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://sambeetpanda507.github.io" />
  <link rel="canonical" href="https://sambeetpanda507.github.io" />
  <link rel="icon" href="/favicon.svg" />
  <title>Sambeet Sekhar Panda — Backend-Focused Software Engineer</title>
  <script is:inline>
    const t = localStorage.getItem('theme');
    document.documentElement.dataset.theme = t || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  </script>
</head>
<body>
<header>
  <nav class="wrap">
    <a class="brand" href="#top">Sambeet<span>.</span></a>
    <div class="navlinks"><a href="#about">About</a><a href="#experience">Experience</a><a href="#projects">Projects</a><a href="#skills">Skills</a><a href="#contact">Contact</a></div>
    <div class="actions">
      <a class="icon" href="https://github.com/sambeetpanda507" target="_blank" rel="noreferrer" aria-label="GitHub">GH</a>
      <a class="icon linkedin-icon" href={linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">in</a>
      <button class="icon" id="theme" aria-label="Toggle theme">◐</button>
    </div>
  </nav>
</header>

<main id="top">
  <section class="hero wrap">
    <div>
      <div class="status"><i></i> Building reliable backend systems & developer platforms</div>
      <p class="eyebrow">BACKEND-FOCUSED SOFTWARE ENGINEER · FULL-STACK DEVELOPER</p>
      <h1>Sambeet Sekhar <span>Panda.</span></h1>
      <p class="lead">I build backend systems, APIs, data-heavy applications, developer tooling, and AI-assisted workflows — with a focus on clear architecture and practical engineering.</p>
      <div class="cta"><a class="primary" href="#projects">View projects ↗</a><a class="secondary" href="https://github.com/sambeetpanda507" target="_blank" rel="noreferrer">GitHub</a><a class="secondary" href={linkedin} target="_blank" rel="noreferrer">LinkedIn</a></div>
    </div>
    <aside class="terminal"><div class="dots">● ● ● <small>sambeet@portfolio ~</small></div><pre><b>$</b> whoami
<strong>backend-focused software engineer</strong>

<b>$</b> primary --languages
<strong>Go        Python</strong>

<b>$</b> focus --current
<span>APIs      databases
search     developer tooling</span>

<b>$</b> principle
<strong>clarity &gt; cleverness</strong></pre></aside>
  </section>

  <section class="section wrap" id="about">
    <div class="label"><span>01</span> ABOUT</div>
    <div class="twocol">
      <h2>I build systems that stay <span>understandable as they grow.</span></h2>
      <div><p>Backend-focused software engineer working across APIs, data systems, databases, distributed workflows, developer infrastructure, and cloud delivery.</p><p>I also build AI/LLM capabilities where they solve a concrete engineering or product problem.</p><p>I care about clear boundaries, predictable failure modes, useful automation, and choosing the simplest architecture that can reliably carry the load.</p></div>
    </div>
  </section>

  <section class="section wrap" id="experience">
    <div class="label"><span>02</span> EXPERIENCE & EDUCATION</div>
    <div class="timeline-stack">
      <article class="experience"><div><p>CURRENT</p><h3>Lead Developer</h3><strong>Starweaver</strong></div><div><p>Leading software engineering across backend services, system integrations, developer workflows, production delivery, and selected AI-enabled capabilities.</p><ul><li>Design and review production APIs, backend workflows, and system integrations.</li><li>Drive CI/CD, pull-request quality, release practices, and engineering automation.</li><li>Support engineers through architecture decisions, code review, and delivery planning.</li></ul></div></article>
      <article class="experience previous-role"><div><p>PREVIOUS</p><h3>Associate Full Stack Developer</h3><strong><a href="https://www.webmobi.com" target="_blank" rel="noreferrer">webMOBI ↗</a></strong></div><div><p>Worked across the full stack on webMOBI’s event technology platform, contributing to frontend, backend, and application workflows.</p></div></article>
      <article class="education-card"><div><p>2014 — 2018</p><h3>Biju Patnaik University of Technology, Odisha</h3></div><div><span>Education</span><p>Undergraduate education listed on my public LinkedIn profile.</p></div></article>
    </div>
  </section>

  <section class="section wrap" id="projects">
    <div class="label"><span>03</span> REPOSITORY-BACKED PROJECTS</div>
    <div class="heading"><h2>Systems you can <span>inspect, not just read about.</span></h2><p>Every project below is tied to a public repository. Project descriptions, system design, and scalability notes are based on what is actually present in the code or repository documentation.</p></div>
    <div class="grid">
      {projects.map((p, i) =>
        <article class="card">
          <a class="card-main" href={`/projects/${p.slug}/`} target="_blank" rel="noreferrer" aria-label={`Open ${p.title} project details`}>
            <div class="num">0{i + 1}</div>
            <p class="tag">{p.tag}</p>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            <div class="architecture"><b>ARCHITECTURE / STACK</b>{p.stack.join(' · ')}</div>
            <span class="details-link">View system design & scalability ↗</span>
          </a>
          <a class="repo-link" href={p.repo} target="_blank" rel="noreferrer" onclick="event.stopPropagation()">GitHub repository ↗</a>
        </article>
      )}
    </div>
  </section>

  <section class="section wrap" id="skills">
    <div class="label"><span>04</span> ENGINEERING TOOLKIT</div>
    <div class="skills-intro"><h2>Backend first. <span>Go & Python in focus.</span></h2><p>I work across the stack, while deliberately deepening backend engineering around Go, Python, PostgreSQL, distributed systems, APIs, reliability, and infrastructure.</p></div>
    <div class="skill-groups">{skillGroups.map((group, i) => <article class:list={["skill-group", i === 0 && "featured-skill"]}><div class="skill-head"><div><span class="skill-index">0{i + 1}</span><h3>{group.title}</h3></div><small>{group.note}</small></div><div class="skill-list">{group.skills.map((skill) => <span class="skill-chip">{skill}</span>)}</div></article>)}</div>
  </section>

  <section class="section wrap"><div class="label"><span>05</span> ENGINEERING PHILOSOPHY</div><div class="principles">{principles.map((p, i) => <article><span>0{i + 1}</span><h3>{p[0]}</h3><p>{p[1]}</p></article>)}</div></section>

  <section class="section wrap contact" id="contact"><div class="label"><span>06</span> CONTACT</div><h2>Let's build something <span>interesting.</span></h2><p>For backend/software engineering roles, collaboration, or a good systems discussion:</p><div class="cta"><a class="primary" href="mailto:sambeetsekharpanda10@gmail.com">Email me ↗</a><a class="secondary" href="https://github.com/sambeetpanda507" target="_blank" rel="noreferrer">GitHub</a><a class="secondary" href={linkedin} target="_blank" rel="noreferrer">LinkedIn</a></div></section>
</main>

<footer class="wrap"><span>© {new Date().getFullYear()} Sambeet Sekhar Panda</span><span>Built with Astro · Hosted on GitHub Pages</span></footer>

<script is:inline>
  document.getElementById('theme')?.addEventListener('click', () => {
    const n = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = n;
    localStorage.setItem('theme', n);
  });
</script>

<style>
:root{--bg:#090a0c;--card:#111216;--text:#f4f4f1;--muted:#9a9ba3;--line:#25262b;--accent:#d8ff66;--soft:#15161a}html[data-theme=light]{--bg:#f7f7f3;--card:#fff;--text:#141416;--muted:#66676d;--line:#dddeda;--accent:#5e7800;--soft:#efefe9}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;line-height:1.65}body:before{content:'';position:fixed;inset:0;z-index:-1;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:64px 64px;mask-image:linear-gradient(#000,transparent 55%);opacity:.3}a{color:inherit;text-decoration:none}.wrap{width:min(1160px,calc(100% - 42px));margin:auto}header{position:sticky;top:0;z-index:10;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:blur(18px)}nav{height:72px;display:flex;align-items:center;gap:32px}.brand{font-weight:900;font-size:1.1rem}.brand span,h1 span,h2 span{color:var(--accent)}.navlinks{margin-left:auto;display:flex;gap:26px}.navlinks a{font-size:.84rem;color:var(--muted)}.actions{display:flex;gap:8px}.icon{border:1px solid var(--line);background:var(--card);border-radius:9px;height:37px;min-width:37px;display:grid;place-items:center;font-size:.7rem;color:var(--text);cursor:pointer}.linkedin-icon{font-weight:900;font-size:.85rem}.hero{min-height:760px;display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:center}.status{display:inline-flex;gap:9px;align-items:center;border:1px solid var(--line);border-radius:999px;padding:7px 11px;color:var(--muted);font-size:.75rem}.status i{width:7px;height:7px;background:var(--accent);border-radius:50%;box-shadow:0 0 15px var(--accent)}.eyebrow,.label,.tag{font-family:ui-monospace,SFMono-Regular,monospace;font-size:.72rem;letter-spacing:.12em;color:var(--muted)}.eyebrow{margin-top:30px}h1{font-size:clamp(3.3rem,7vw,6.8rem);line-height:.9;letter-spacing:-.07em;margin:18px 0 28px;max-width:760px}.lead{font-size:1.15rem;color:var(--muted);max-width:650px}.cta{display:flex;align-items:center;gap:12px;margin-top:34px;flex-wrap:wrap}.primary,.secondary{display:inline-flex;padding:11px 15px;border-radius:9px;font-size:.84rem;font-weight:700}.primary{background:var(--accent);color:#111}.secondary{border:1px solid var(--line);background:var(--card)}.terminal{border:1px solid var(--line);background:var(--card);border-radius:16px;overflow:hidden}.dots{padding:13px 16px;border-bottom:1px solid var(--line);color:#686970;font-size:.65rem;letter-spacing:3px}.dots small{margin-left:12px;letter-spacing:0}.terminal pre{padding:28px;margin:0;min-height:310px;white-space:pre-wrap;color:var(--muted);font:13px/1.8 ui-monospace,monospace}.terminal b{color:var(--accent)}.terminal strong{color:var(--text)}.section{padding:118px 0;border-top:1px solid var(--line)}.label{margin-bottom:44px}.label span{color:var(--accent);margin-right:12px}.twocol,.heading{display:grid;grid-template-columns:1fr 1fr;gap:90px}.heading{align-items:end;margin-bottom:44px}.heading p,.twocol p,.contact p{color:var(--muted)}h2{font-size:clamp(2.4rem,5vw,4.7rem);line-height:1;letter-spacing:-.055em;margin:0}h3{letter-spacing:-.03em}.timeline-stack{display:grid;gap:14px}.experience{display:grid;grid-template-columns:.4fr 1fr;gap:70px;padding:38px;border:1px solid var(--line);background:var(--card);border-radius:14px}.experience h3{font-size:1.8rem;margin:8px 0}.experience p,.experience li{color:var(--muted)}.previous-role{background:var(--soft)}.education-card{display:grid;grid-template-columns:.4fr 1fr;gap:70px;padding:28px 38px;border:1px solid var(--line);border-radius:14px;background:var(--soft)}.education-card p{color:var(--muted);margin:0}.education-card h3{margin:5px 0}.education-card span{font-family:ui-monospace,monospace;color:var(--accent);font-size:.7rem;text-transform:uppercase;letter-spacing:.1em}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.card{border:1px solid var(--line);background:var(--card);border-radius:14px;transition:.2s;overflow:hidden}.card:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--accent) 35%,var(--line))}.card-main{display:block;padding:32px 32px 22px}.card-main>p{color:var(--muted)}.num{font-family:ui-monospace,monospace;color:var(--muted);float:right}.card h3{font-size:1.45rem;margin:10px 0}.architecture{border-top:1px solid var(--line);padding-top:18px;margin-top:24px;color:var(--muted);font-size:.78rem}.architecture b{display:block;color:var(--text);font-size:.65rem;letter-spacing:.1em;margin-bottom:6px}.details-link{display:inline-block;margin-top:18px;color:var(--accent);font-size:.75rem;font-family:ui-monospace,monospace}.repo-link{display:block;border-top:1px solid var(--line);padding:14px 32px;color:var(--accent);font-size:.75rem;font-family:ui-monospace,monospace;background:var(--soft)}.repo-link:hover{text-decoration:underline}.skills-intro{display:grid;grid-template-columns:1.15fr .85fr;gap:80px;align-items:end;margin-bottom:42px}.skills-intro p{color:var(--muted);margin:0}.skill-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.skill-group{border:1px solid var(--line);background:var(--card);border-radius:14px;padding:28px}.skill-group.featured-skill{grid-column:span 2}.skill-head{display:flex;justify-content:space-between;gap:20px;margin-bottom:24px}.skill-head>div{display:flex;align-items:baseline;gap:12px}.skill-index{font-family:ui-monospace,monospace;color:var(--accent);font-size:.68rem}.skill-head h3{font-size:1.2rem;margin:0}.skill-head small{font-family:ui-monospace,monospace;color:var(--muted);font-size:.64rem}.skill-list{display:flex;flex-wrap:wrap;gap:8px}.skill-chip{border:1px solid var(--line);background:var(--soft);padding:8px 11px;border-radius:8px;font-size:.78rem}.principles{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.principles article{border:1px solid var(--line);background:var(--card);padding:25px;border-radius:12px}.principles article>span{font-family:monospace;color:var(--accent);font-size:.72rem}.principles p{color:var(--muted);font-size:.86rem}.contact{text-align:center}footer{padding:32px 0 44px;border-top:1px solid var(--line);display:flex;justify-content:space-between;color:var(--muted);font-size:.75rem}@media(max-width:820px){.navlinks{display:none}.actions{margin-left:auto}.hero{grid-template-columns:1fr;min-height:auto;padding:110px 0 80px}.terminal{display:none}.twocol,.heading,.experience,.education-card,.skills-intro{grid-template-columns:1fr;gap:30px}.grid,.skill-groups{grid-template-columns:1fr}.skill-group.featured-skill{grid-column:auto}.principles{grid-template-columns:1fr 1fr}.section{padding:82px 0}}@media(max-width:520px){h1{font-size:3.8rem}.wrap{width:min(100% - 28px,1160px)}.principles{grid-template-columns:1fr}.experience,.education-card{padding:24px}footer{gap:16px;flex-direction:column}}
</style>
</body>
</html>
