---
import Head from '../components/Head.astro';
import { projects } from '../data/projects';
const linkedin = 'https://www.linkedin.com/in/sambeetsekharpanda/';

const skillGroups = [
  { title: 'Backend Languages & APIs', note: 'Primary focus', skills: ['Node.js','TypeScript','Go','Express','REST APIs','Authentication'] },
  { title: 'Databases & Search', note: 'Deepening expertise', skills: ['PostgreSQL','MongoDB','Redis','pgvector','BM25','Full-text Search','Indexing','Query Optimization'] },
  { title: 'Systems & Infrastructure', note: 'Production delivery', skills: ['Docker','Azure','GitHub Actions','CI/CD','Linux','RabbitMQ','Distributed Workflows','Observability'] },
  { title: 'Applied AI Engineering', note: 'Supporting capability', skills: ['Python','FastAPI','LangGraph','LangChain','RAG','Embeddings','Vector Databases','LLM APIs','Agent Workflows'] },
  { title: 'Frontend & Product', note: 'Full-stack delivery', skills: ['React','Next.js','Astro','Vue.js','HTML','CSS','Responsive UI'] },
];

const principles = [
  ['Build for clarity', 'Readable systems beat clever systems.'],
  ['Measure before optimizing', 'Performance work should be driven by evidence.'],
  ['Design for failure', 'Production systems should assume dependencies can fail.'],
  ['Automate repetition', 'Tooling should reduce developer friction.'],
];

const terminal: [string, 'cmd' | 'out' | 'list' | 'blank'][] = [
  ['whoami', 'cmd'], ['backend-focused software engineer', 'out'], ['', 'blank'],
  ['primary --stack', 'cmd'], ['Node.js   TypeScript   Go', 'out'], ['', 'blank'],
  ['focus --current', 'cmd'], ['APIs      PostgreSQL', 'list'], ['search     distributed workflows', 'list'], ['developer tooling   system design', 'list'], ['', 'blank'],
  ['role', 'cmd'], ['Lead Developer', 'out'],
];
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <Head
    title="Sambeet Sekhar Panda — Backend-Focused Software Engineer"
    description="Portfolio of Sambeet Sekhar Panda, a backend-focused software engineer and Lead Developer working primarily with Node.js, TypeScript, Go, APIs, databases, distributed workflows, developer tooling, cloud delivery, and search systems."
    ogDescription="Backend engineering with Node.js, TypeScript, Go, PostgreSQL, distributed systems, APIs, developer tooling, cloud delivery, and applied AI."
    url="https://sambeetpanda507.github.io"
  />
</head>
<body>
<header class="site-header">
  <nav class="wrap nav-row">
    <a class="brand" href="#top">Sambeet<span>.</span></a>
    <div class="navlinks" id="navlinks">
      <span class="nav-pill" aria-hidden="true"></span>
      <a href="#about">About</a><a href="#experience">Experience</a><a href="#projects">Projects</a><a href="#skills">Skills</a><a href="/blogs/">Blogs</a><a href="#contact">Contact</a>
    </div>
    <div class="actions">
      <a class="icon" href="https://github.com/sambeetpanda507" target="_blank" rel="noreferrer" aria-label="GitHub">GH</a>
      <a class="icon" href={linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">in</a>
      <button class="icon" id="theme" type="button" aria-label="Toggle theme">◐</button>
      <button class="icon nav-toggle" type="button" data-menu-toggle aria-label="Toggle menu" aria-expanded="false" aria-controls="navlinks">☰</button>
    </div>
  </nav>
  <div class="progress" aria-hidden="true"></div>
</header>

<main id="top">
  <section class="hero wrap" id="hero">
    <canvas class="field" id="field" aria-hidden="true"></canvas>
    <div class="hero-copy">
      <div class="status fade-in" style="--d:60ms"><i></i> Building reliable backend systems & developer platforms</div>
      <p class="eyebrow fade-in" style="--d:160ms">BACKEND-FOCUSED SOFTWARE ENGINEER · LEAD DEVELOPER</p>
      <h1 class="name" id="name" aria-label="Sambeet Sekhar Panda.">
        <span class="line" aria-hidden="true">Sambeet</span>
        <span class="line" aria-hidden="true">Sekhar</span>
        <span class="line accent" aria-hidden="true">Panda.</span>
      </h1>
      <p class="lead fade-in" style="--d:700ms">I build backend systems with Node.js, TypeScript, and Go — APIs, data-heavy applications, developer tooling, distributed workflows, and AI-assisted products designed to stay clear as systems grow.</p>
      <div class="cta fade-in" style="--d:850ms">
        <a class="btn primary magnet" href="#projects">View projects <span class="arr">↗</span></a>
        <a class="btn magnet" href="https://github.com/sambeetpanda507" target="_blank" rel="noreferrer">GitHub</a>
        <a class="btn magnet" href={linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </div>
    <div class="stage fade-in" style="--d:400ms">
      <div class="slab" id="slab">
        <aside class="terminal">
          <div class="dots">● ● ● <small>sambeet@portfolio ~</small></div>
          <pre>{terminal.map(([text, kind], i) => (
            <span class:list={['tline', kind]} style={`--i:${i}`}>{kind === 'cmd' ? <><b>$</b> {text}</> : kind === 'blank' ? ' ' : kind === 'out' ? <strong>{text}</strong> : text}</span>
          ))}</pre>
        </aside>
      </div>
    </div>
  </section>

  <section class="section wrap" id="about">
    <div class="label"><span>01</span> ABOUT</div>
    <div class="body">
      <div class="twocol">
        <h2 class="statement" id="statement">I like backend problems where <span class="accent">architecture, data, and delivery all matter.</span></h2>
        <div class="prose rv">
          <p>I’m a backend-focused software engineer and Lead Developer with a full-stack background. I started by working heavily with JavaScript and the MERN ecosystem, and over time moved deeper into APIs, databases, system design, infrastructure, CI/CD, developer tooling, and distributed backend workflows.</p>
          <p>My core backend stack is Node.js, TypeScript, and Go, backed by PostgreSQL, MongoDB, search systems, distributed processing, and reliability-focused engineering. I still work across React and Next.js when the product needs it, while increasingly spending my energy on the system behind the UI.</p>
          <p>Professionally, I’ve worked on edtech and event-technology products, including learning experience platforms, collaborative editors, course-generation pipelines, reporting systems, authentication flows, developer workflows, and AI-assisted tools.</p>
          <p>I’m especially interested in systems where failure handling, state, indexing, queues, background processing, data modeling, observability, and clean service boundaries matter more than flashy abstractions.</p>
        </div>
      </div>
      <div class="about-grid">
        <article class="rv"><span>01</span><h3>Backend engineering</h3><p>Node.js, TypeScript, Go, APIs, authentication, service boundaries, background processing, data workflows, failure modes, and maintainable server-side architecture.</p></article>
        <article class="rv"><span>02</span><h3>Data & search</h3><p>PostgreSQL, MongoDB, indexing, full-text search, vector retrieval, BM25, hybrid search, and query design.</p></article>
        <article class="rv"><span>03</span><h3>Engineering systems</h3><p>CI/CD, pull-request quality, GitHub Actions, Azure deployments, release workflows, code review, and developer automation.</p></article>
        <article class="rv"><span>04</span><h3>Applied AI</h3><p>LLM workflows, LangGraph, document processing, embeddings, retrieval, human-in-the-loop pipelines, and AI-assisted developer tools.</p></article>
      </div>
    </div>
  </section>

  <section class="section wrap" id="experience">
    <div class="label"><span>02</span> EXPERIENCE & EDUCATION</div>
    <div class="body">
      <div class="timeline-stack" id="timeline">
        <i class="timeline-fill" aria-hidden="true"></i>
        <article class="experience current"><div><p class="when">CURRENT</p><h3>Lead Developer</h3><strong>Starweaver</strong></div><div><p>Leading software engineering across backend services, system integrations, developer workflows, production delivery, and selected AI-enabled capabilities.</p><ul><li>Design and review production APIs, backend workflows, and system integrations.</li><li>Drive CI/CD, pull-request quality, release practices, and engineering automation.</li><li>Support engineers through architecture decisions, code review, and delivery planning.</li><li>Work across learning-platform capabilities including Journeybuilder, analytics, collaboration, content workflows, AI-assisted generation, and internal engineering systems.</li></ul></div></article>
        <article class="experience"><div><p class="when">PREVIOUS</p><h3>Associate Full Stack Developer</h3><strong><a href="https://www.webmobi.com" target="_blank" rel="noreferrer">webMOBI ↗</a></strong></div><div><p>Worked across the full stack on webMOBI’s event technology platform, contributing to frontend, backend, and application workflows.</p><ul><li>Built and maintained application functionality across web interfaces and backend services.</li><li>Worked in a product environment where event-management workflows required both frontend delivery and server-side integration.</li></ul></div></article>
        <article class="experience education"><div><p class="when">2014 — 2018</p><h3>Biju Patnaik University of Technology, Odisha</h3></div><div><span class="kind">Education</span><p>Undergraduate education listed on my public LinkedIn profile.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section wrap" id="projects">
    <div class="label"><span>03</span> SELECTED PROJECTS</div>
    <div class="body">
      <div class="heading"><h2 class="wipe">Systems I have <span>built and worked on.</span></h2><p>Each project opens as a full case study in this portfolio. Public projects also link to source code; professional projects document the problem, my contribution, design decisions, execution flow, architecture, scalability, and limitations without inventing private metrics.</p></div>
      <div class="grid" id="project-grid">
        {projects.map((p, i) =>
          <article class="card">
            <a class="card-main" href={`/projects/${p.slug}/`} aria-label={`Open ${p.title} project details`}>
              <div class="num">0{i + 1}</div>
              <p class="tag">{p.tag}</p>
              <h3>{p.title}</h3>
              <p>{p.summary}</p>
              <div class="architecture"><b>ARCHITECTURE / STACK</b>{p.stack.join(' · ')}</div>
              <span class="details-link">Read project case study <span class="arr">→</span></span>
            </a>
            {'repo' in p && p.repo && <a class="repo-link" href={p.repo} target="_blank" rel="noreferrer">GitHub repository ↗</a>}
          </article>
        )}
      </div>
    </div>
  </section>

  <section class="section wrap" id="skills">
    <div class="label"><span>04</span> ENGINEERING TOOLKIT</div>
    <div class="body">
      <div class="skills-intro"><h2 class="wipe">Backend first. <span>Node.js, TypeScript & Go in focus.</span></h2><p>I work across the stack, with my primary backend emphasis on Node.js, TypeScript, and Go alongside PostgreSQL, distributed systems, APIs, reliability, and infrastructure. Python remains a supporting tool for selected AI and automation work.</p></div>
      <div class="skill-groups">{skillGroups.map((group, i) => <article class:list={['skill-group', 'rv', i === 0 && 'featured-skill']}><div class="skill-head"><div><span class="skill-index">0{i + 1}</span><h3>{group.title}</h3></div><small>{group.note}</small></div><div class="skill-list">{group.skills.map((skill) => <span class="skill-chip">{skill}</span>)}</div></article>)}</div>
    </div>
  </section>

  <section class="section wrap">
    <div class="label"><span>05</span> ENGINEERING PHILOSOPHY</div>
    <div class="body">
      <div class="principles">{principles.map((p, i) => <article><span>0{i + 1}</span><h3>{p[0]}</h3><p>{p[1]}</p></article>)}</div>
    </div>
  </section>

  <section class="section wrap contact" id="contact">
    <div class="label"><span>06</span> CONTACT</div>
    <div class="body">
      <h2 class="big"><span class="ln">Let's build</span> <span class="ln outline">something</span> <span class="ln accent">interesting.</span></h2>
      <p>For backend/software engineering roles, collaboration, or a good systems discussion:</p>
      <div class="cta"><a class="btn primary magnet" href="mailto:sambeetsekharpanda10@gmail.com">Email me <span class="arr">↗</span></a><a class="btn magnet" href="https://github.com/sambeetpanda507" target="_blank" rel="noreferrer">GitHub</a><a class="btn magnet" href={linkedin} target="_blank" rel="noreferrer">LinkedIn</a></div>
    </div>
  </section>
</main>

<footer class="site-footer"><div class="wrap"><span>© {new Date().getFullYear()} Sambeet Sekhar Panda</span><span>Built with Astro · Hosted on GitHub Pages</span></div></footer>

<script>
  import '../scripts/home';
</script>

<style is:global>
/* hero */
.hero { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); gap: clamp(32px, 5vw, 72px); align-items: center; padding-block: clamp(64px, 9vw, 120px) clamp(56px, 8vw, 110px); }
.hero > * { min-width: 0; }
.field { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; -webkit-mask-image: radial-gradient(ellipse 70% 90% at 70% 50%, #000 25%, transparent 78%); mask-image: radial-gradient(ellipse 70% 90% at 70% 50%, #000 25%, transparent 78%); }
.status { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px 8px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); color: var(--muted); font-size: .8rem; }
.status i { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); animation: beat 2.4s infinite; }
@keyframes beat { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent); } 70% { box-shadow: 0 0 0 9px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
.eyebrow { margin: 28px 0 0; font: 500 .74rem/1.5 var(--mono); letter-spacing: .1em; color: var(--muted); }
.name { margin: 18px 0 28px; font-size: clamp(3.3rem, 8.6vw, 8rem); font-weight: 850; font-stretch: 118%; line-height: .86; letter-spacing: -.045em; }
.name .line { display: block; overflow: hidden; padding-bottom: .06em; }
.name .accent { color: var(--signal); }
.name .ch { display: inline-block; }
.lead { margin: 0; max-width: 56ch; color: var(--muted); font-size: clamp(1.05rem, 1.4vw, 1.2rem); }
.hero .cta { margin-top: 34px; }

.stage { perspective: 1400px; }
.slab { position: relative; transform-style: preserve-3d; transform: rotateX(var(--tx, 5deg)) rotateY(var(--ty, -10deg)); transition: transform .8s var(--ease); }
.slab::before, .slab::after { content: ''; position: absolute; inset: 0; border: 1px solid var(--line); border-radius: 18px; background: var(--panel-2); pointer-events: none; }
.slab::before { transform: translate3d(14px, 14px, -40px); opacity: .75; }
.slab::after { transform: translate3d(28px, 28px, -80px); opacity: .4; }
.terminal { position: relative; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); overflow: hidden; box-shadow: 0 30px 80px -40px rgba(0, 0, 0, .55); }
.dots { padding: 14px 18px; border-bottom: 1px solid var(--line); color: var(--faint); font-size: .65rem; letter-spacing: 3px; }
.dots small { margin-left: 12px; letter-spacing: 0; font-family: var(--mono); }
.terminal pre { margin: 0; padding: 28px; min-height: 330px; color: var(--muted); font: 13.5px/1.8 var(--mono); white-space: pre-wrap; }
.tline { display: block; }
.terminal b { color: var(--signal); font-weight: 500; }
.terminal strong { color: var(--fg); font-weight: 500; }
.terminal pre::after { content: '▋'; color: var(--signal); animation: blink 1.1s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0; } }

/* sections with a label rail */
.section { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: clamp(20px, 4vw, 56px); padding-block: clamp(80px, 10vw, 130px); border-top: 1px solid var(--line); }
.section > * { min-width: 0; }
.section > .label { position: sticky; top: 100px; align-self: start; }
.section h2 { margin: 0; font-size: clamp(2.2rem, 4.8vw, 4.3rem); font-weight: 800; font-stretch: 108%; line-height: 1; letter-spacing: -.035em; }
.section h2 span { color: var(--signal); }
.section p { color: var(--muted); }

.twocol { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); }
.statement .w { color: var(--faint); transition: color .35s; }
.statement .w.lit { color: var(--fg); }
.statement .accent .w.lit { color: var(--signal); }
.prose p { margin: 0 0 18px; }
.about-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 56px; }
.about-grid article, .principles article { padding: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); transition: transform .4s var(--ease), border-color .3s; }
.about-grid article:hover, .principles article:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--signal) 55%, var(--line)); }
.about-grid article > span, .principles article > span { font: 500 .7rem/1 var(--mono); color: var(--signal); }
.about-grid h3, .principles h3 { margin: 12px 0 8px; font-size: 1.15rem; font-weight: 700; }
.about-grid p, .principles p { margin: 0; font-size: .9rem; }

/* experience timeline */
.timeline-stack { position: relative; display: grid; gap: 16px; padding-left: 34px; }
.timeline-stack::before, .timeline-fill { content: ''; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: var(--line); }
.timeline-fill { background: linear-gradient(var(--signal), var(--hot)); transform-origin: top; transform: scaleY(var(--p, 1)); }
.experience { position: relative; display: grid; grid-template-columns: minmax(0, .42fr) minmax(0, 1fr); gap: clamp(16px, 4vw, 56px); padding: 32px; border: 1px solid var(--line); border-radius: 16px; background: var(--panel); transition: border-color .3s; }
.experience:hover { border-color: color-mix(in srgb, var(--signal) 50%, var(--line)); }
.experience::before { content: ''; position: absolute; left: -33px; top: 38px; width: 14px; height: 14px; border-radius: 50%; background: var(--ink); border: 2px solid var(--signal); }
.experience.current::before { background: var(--signal); box-shadow: 0 0 0 6px color-mix(in srgb, var(--signal) 22%, transparent); }
.experience.education { background: var(--panel-2); }
.section .when { margin: 0; font: 500 .72rem/1 var(--mono); letter-spacing: .08em; color: var(--ok); }
.experience h3 { margin: 12px 0 6px; font-size: 1.6rem; font-weight: 750; letter-spacing: -.02em; }
.experience strong { color: var(--muted); font-weight: 500; }
.experience strong a { border-bottom: 1px solid var(--line); transition: color .2s, border-color .2s; }
.experience strong a:hover { color: var(--signal); border-color: var(--signal); }
.experience p { margin: 0 0 12px; }
.experience ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
.experience li { position: relative; padding-left: 22px; color: var(--muted); font-size: .95rem; }
.experience li::before { content: '→'; position: absolute; left: 0; color: var(--signal); font-family: var(--mono); }
.kind { display: block; margin-bottom: 8px; font: 500 .7rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--signal); }

/* projects */
.heading, .skills-intro { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 24px clamp(28px, 5vw, 72px); align-items: end; margin-bottom: 44px; }
.heading p, .skills-intro p { margin: 0; }
.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; perspective: 1400px; }
.card { --mx: 50%; --my: 50%; --rx: 0deg; --ry: 0deg; position: relative; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); transform: rotateX(var(--rx)) rotateY(var(--ry)); transform-style: preserve-3d; transition: transform .5s var(--ease), border-color .3s; }
.card::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(420px circle at var(--mx) var(--my), color-mix(in srgb, var(--signal) 18%, transparent), transparent 45%); opacity: 0; transition: opacity .35s; pointer-events: none; }
.card:hover { border-color: color-mix(in srgb, var(--signal) 50%, var(--line)); }
.card:hover::before { opacity: 1; }
.card-main { position: relative; display: flex; flex-direction: column; flex: 1; padding: 30px 30px 24px; transform-style: preserve-3d; }
.card-main > * { transition: transform .5s var(--ease); }
.card:hover .tag { transform: translateZ(16px); }
.card:hover h3 { transform: translateZ(34px); }
.card:hover .architecture { transform: translateZ(20px); }
.card:hover .details-link { transform: translateZ(26px); }
.num { position: absolute; top: 30px; right: 30px; font: 500 .74rem/1 var(--mono); color: var(--faint); }
.section .tag { margin: 0; padding-right: 40px; font: 500 .7rem/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ok); }
.card h3 { margin: 12px 0 10px; font-size: 1.5rem; font-weight: 750; font-stretch: 104%; letter-spacing: -.02em; line-height: 1.12; }
.card-main > p:not(.tag) { margin: 0; font-size: .95rem; }
.architecture { margin-top: auto; padding-top: 18px; border-top: 1px solid var(--line); color: var(--muted); font: 400 .78rem/1.6 var(--mono); }
.card-main > p + .architecture { margin-top: 24px; }
.architecture b { display: block; margin-bottom: 6px; color: var(--fg); font-weight: 500; font-size: .66rem; letter-spacing: .1em; }
.details-link { margin-top: 18px; color: var(--signal); font: 500 .78rem/1 var(--mono); }
.details-link .arr { display: inline-block; transition: transform .35s var(--ease); }
.card:hover .details-link .arr { transform: translateX(5px); }
.repo-link { position: relative; display: block; padding: 14px 30px; border-top: 1px solid var(--line); border-radius: 0 0 18px 18px; background: var(--panel-2); color: var(--muted); font: 500 .76rem/1 var(--mono); transition: color .2s; }
.repo-link:hover { color: var(--fg); }

/* skills */
.skill-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.skill-group { padding: 26px; border: 1px solid var(--line); border-radius: 16px; background: var(--panel); transition: border-color .3s; }
.skill-group:hover { border-color: color-mix(in srgb, var(--signal) 45%, var(--line)); }
.skill-group.featured-skill { grid-column: span 2; }
.skill-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 20px; }
.skill-head > div { display: flex; align-items: baseline; gap: 12px; }
.skill-index { font: 500 .7rem/1 var(--mono); color: var(--signal); }
.skill-head h3 { margin: 0; font-size: 1.15rem; font-weight: 700; }
.skill-head small { font: 500 .68rem/1.3 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ok); text-align: right; }
.skill-list { display: flex; flex-wrap: wrap; gap: 8px; }
.skill-chip { padding: 8px 11px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel-2); font: 500 .8rem/1 var(--mono); transition: transform .3s var(--ease), border-color .2s, color .2s; }
.skill-chip:hover { transform: translateY(-3px); border-color: var(--signal); color: var(--signal); }

/* principles */
.principles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }

/* contact */
.contact .body { perspective: 1300px; }
.section .big { font-size: clamp(2.6rem, 9.5vw, 8.6rem); font-weight: 880; font-stretch: 120%; line-height: .9; letter-spacing: -.05em; transform: rotateX(var(--cx, 10deg)) rotateY(var(--cy, -8deg)); transform-origin: 30% 50%; transition: transform .9s var(--ease); overflow-wrap: anywhere; }
.big .ln { display: block; color: var(--fg); --ex: color-mix(in srgb, var(--fg) 20%, var(--ink)); text-shadow: 1px 1px 0 var(--ex), 2px 2px 0 var(--ex), 3px 3px 0 var(--ex), 4px 4px 0 var(--ex), 5px 5px 0 var(--ex), 6px 6px 0 var(--ex), 7px 7px 0 var(--ex), 8px 8px 0 var(--ex), 16px 22px 34px rgba(0, 0, 0, .35); }
.big .ln.accent { color: var(--signal); --ex: color-mix(in srgb, var(--signal) 42%, var(--ink)); }
