-size:1.2rem;margin:0}.skill-head small{font-family:ui-monospace,monospace;color:var(--muted);font-size:.64rem;letter-spacing:.08em;text-transform:uppercase}.skill-list{display:flex;flex-wrap:wrap;gap:8px}.skill-chip{border:1px solid var(--line);background:var(--soft);padding:8px 11px;border-radius:8px;font-size:.78rem;transition:.18s}.skill-chip:hover{border-color:color-mix(in srgb,var(--accent) 45%,var(--line));transform:translateY(-1px)}.skill-chip.skill-highlight{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,var(--soft));font-weight:800;font-size:.9rem;padding:9px 14px;box-shadow:0 0 24px color-mix(in srgb,var(--accent) 10%,transparent)}.skill-highlight b{color:var(--accent);margin-left:7px}.principles{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.principles article{border:1px solid var(--line);background:var(--card);padding:25px;border-radius:12px}.principles article>span{font-family:monospace;color:var(--accent);font-size:.72rem}.principles p{color:var(--muted);font-size:.86rem}.profile-layout{display:flex;justify-content:space-between;align-items:center;gap:50px}.profile-layout>div{max-width:780px}.profile-layout img{border-radius:24px;border:1px solid var(--line)}.profile-links{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:30px}.profile-link{border:1px solid var(--line);background:var(--card);border-radius:12px;padding:18px;display:flex;flex-direction:column;gap:4px}.profile-link span{color:var(--muted);font-size:.78rem}.profile-link:hover{border-color:color-mix(in srgb,var(--accent) 45%,var(--line))}.contact{text-align:center}.contact p{font-size:1.05rem}footer{padding:32px 0 44px;border-top:1px solid var(--line);display:flex;justify-content:space-between;color:var(--muted);font-size:.75rem}footer a:hover{color:var(--accent)}@media(max-width:820px){.navlinks{display:none}.actions{margin-left:auto}.hero{grid-template-columns:1fr;min-height:auto;padding:110px 0 80px}.terminal{display:none}.twocol,.head